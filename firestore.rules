rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Portfolio content is publically readable, but write access is restricted.
    // In a real app, you'd restrict this to authenticated admins.
    match /portfolio_content/{docId} {
      allow read: if true;
      allow write: if request.auth != null; // Example: only authenticated users
    }

    // Anyone can submit the contact form.
    match /contact_submissions/{docId} {
      allow read: if request.auth != null; // Only admins should read submissions
      allow create: if true;
    }
  }
}
